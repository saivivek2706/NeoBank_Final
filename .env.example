# Reference of every variable docker-compose reads. DO NOT put real secrets in this file.
# Generate a real .env (fresh random keys and passwords) with:   ./scripts/bootstrap-env.sh

POSTGRES_USER=neobank
POSTGRES_PASSWORD=
MONGO_USER=neobank
MONGO_PASSWORD=

# RS256 signing keypair for auth-service (PKCS#8 private key + X.509 public key, base64 of the PEM files).
# Other services verify tokens with the public half only, fetched from auth-service's JWKS endpoint.
JWT_KEY_ID=neobank-key-1
JWT_PRIVATE_KEY_B64=
JWT_PUBLIC_KEY_B64=

# AES-256 key encrypting PII columns at rest, and the HMAC key for the email blind index.
# Both: `openssl rand -base64 32`, and they must be DIFFERENT keys. Rotating the encryption key
# requires re-encrypting existing rows - it is not a drop-in config change.
PII_ENCRYPTION_KEY_B64=
PII_BLIND_INDEX_KEY_B64=
# Separate AES-256-GCM key for TOTP/MFA secrets. Never reuse the PII encryption key.
MFA_ENCRYPTION_KEY_B64=

# First admin account, created only if both are set (min 12 chars).
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
COMPOSE_PROFILES=observability

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
JWT_JWKS_URI=http://auth-service:8080/.well-known/jwks.json
SWAGGER_UI_ENABLED=true
LOG_FORMAT=ecs

# Per-account transfer attempts allowed per hour (raise for load tests)
VELOCITY_MAX_ATTEMPTS_HOUR=20

# Account service: DEMO ONLY - let customers fund their own accounts (false in any real environment)
ACCOUNT_SELF_SERVICE_FUNDING=true
# Transfer fee schedule charged to the sender (all 0 = free). fee = flat + amount*percent/100, clamped to [min, max]
FEES_TRANSFER_FLAT=0
FEES_TRANSFER_PERCENT=0
FEES_TRANSFER_MINIMUM=0
FEES_TRANSFER_MAXIMUM=0

# Compliance policy (compliance-service)
AML_LARGE_TRANSACTION_THRESHOLD=10000     # a single movement at/above this raises LARGE_TRANSACTION (STRUCTURING uses the 80-100% band below it)
AML_STRUCTURING_MIN_COUNT=3
AML_HIGH_VELOCITY_COUNT=10                # outgoing transfers per hour
SANCTIONS_REVIEW_THRESHOLD=0.88           # fuzzy-match score at/above which a person reviews a sanctions hit
SANCTIONS_FREEZE_ON_POTENTIAL_MATCH=false # an EXACT-name hit is always frozen; set true to freeze close matches too
