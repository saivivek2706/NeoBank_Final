    },
    {
      "id": 20,
      "title": "Sanctions hits (24h)",
      "type": "stat",
      "datasource": {
        "type": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 48,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (outcome) (increase(neobank_sanctions_hits_total[24h]))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {},
      "description": "STRONG_MATCH = exact name, account frozen automatically; POTENTIAL_MATCH = needs a human."
    },
    {
      "id": 21,
      "title": "Audit chain intact",
      "type": "stat",
      "datasource": {
        "type": "prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 48,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "expr": "min(neobank_audit_chain_valid)",
          "legendFormat": "1 = intact",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {},
      "description": "1 while the audit hash chain verifies; 0 means tampering was detected."
    },
    {
      "id": 22,
      "title": "AML alerts by rule (per hour)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus"
      },
      "gridPos": {
        "x": 0,
