    },
    {
      "id": 19,
      "title": "Overdue compliance cases",
      "type": "stat",
      "datasource": {
        "type": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 48,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(neobank_compliance_cases_overdue)",
          "legendFormat": "overdue",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {},
